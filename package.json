    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "format": "prettier --write src tests scripts/*.ts",
    "setup": "tsx scripts/setup-local.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@radix-ui/react-slot": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
